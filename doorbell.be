import gpio

INPUT_PIN = 22
OUTPUT_PIN = 21

sequence = [260,320,320,2080,400,320,1600,320,880,320,2480,240,3760,320,1760,320,1600,320,880,320,1760,400,320,240,3080,360,320,320,240,240,240,320,3040,320,320,320,320,640,320,320,320,400,1280,320,1360,320,320,720,320,320,1280,320,2000,320,320,320,320,720,320,1280,400,320,640,320,320,320,2000,320,320,640,320,400,560,320,400,4960,320,320,640,320,640,320,400,4880,320,640,400,320,640,320,320,320,6880,320,320,320,640,400,320,960,960,320,1040,320,640,640,320,320,320,320,320,1040,320,640,640,640,640,640,1680,320,640,640,640,720,320,320,320,320,320,320,320,320,2960,320,960,320,240,320,400,320,2880,320,1040,320,960,640,640,640,1040,320,320,320,3520,320,320,400,320,320,320,320,320,400,320,320,320,320,2320,320,640,320,720,640,320,320,2000,320,320,400,320,640,320,320,1040,320,640,320,1040,400,640,320,320,640,2320,640,320,400,2640,320,640,320,2720,320,640,320,2640,320,640,320,2640,400,640,320,320,3680,320,320,3680,320,320,3680,320]

def init()
    gpio.pin_mode(OUTPUT_PIN, gpio.OUTPUT_OPEN_DRAIN)
    gpio.pin_mode(INPUT_PIN, gpio.INPUT)
    gpio.digital_write(OUTPUT_PIN, 1)
end

def play_sequence()
    var bit_val = 0
    for interval : sequence
        gpio.digital_write(OUTPUT_PIN, bit_val)
        tasmota.delay_microseconds(interval)
        bit_val=(bit_val == 0 ? 1 : 0)
    end
    gpio.digital_write(OUTPUT_PIN, 1)
end

init()
play_sequence()